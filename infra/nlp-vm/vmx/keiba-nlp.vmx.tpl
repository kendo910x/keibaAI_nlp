# VM15 の導入時の構成見本。既存 VMX には媒体と時刻同期の差分だけを反映する。
.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "14"
displayName = "keiba-nlp"
guestOS = "ubuntu-64"
numvcpus = "2"
memsize = "8192"
firmware = "efi"
scsi0.present = "TRUE"
scsi0.virtualDev = "lsilogic"
scsi0:0.present = "TRUE"
scsi0:0.deviceType = "scsi-hardDisk"
scsi0:0.fileName = "keiba-nlp.vmdk"
ethernet0.present = "TRUE"
ethernet0.virtualDev = "e1000"
ethernet0.networkName = "VLAN 101"
ethernet0.startConnected = "TRUE"

# 導入時。SATA 0:1 は 8 MiB の VFAT CIDATA を収めた VMDK。
ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "/vmfs/volumes/datastore1/iso/ubuntu-24.04.5-live-server-amd64.iso"
ide1:0.startConnected = "TRUE"
sata0.present = "TRUE"
sata0:1.present = "TRUE"
sata0:1.deviceType = "disk"
sata0:1.fileName = "nlp-seed-recovery-r2.vmdk"
sata0:1.startConnected = "TRUE"
boot.order = "cdrom"

# ESXi 6.7。周期同期とツール起動・復帰等での単発のホスト時刻同期。
tools.syncTime = "FALSE"
time.synchronize.continue = "FALSE"
time.synchronize.restore = "FALSE"
time.synchronize.resume.disk = "FALSE"
time.synchronize.shrink = "FALSE"
time.synchronize.tools.startup = "FALSE"
time.synchronize.tools.enable = "FALSE"
time.synchronize.resume.host = "FALSE"
