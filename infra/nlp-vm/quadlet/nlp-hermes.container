[Unit]
Description=NLP research Hermes CLI
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/nlp/hermes /srv/nlp/hermes-runtime /srv/nlp/hermes-private

[Container]
Image=localhost/nlp-runtime:20261127
Pull=never
ContainerName=nlp-hermes
Network=host
Volume=/srv/nlp/hermes:/opt/data
Volume=/srv/nlp/hermes-runtime/config.yaml:/opt/data/config.yaml:ro
Volume=/srv/nlp/hermes-private/nlp_app:/run/secrets/nlp_app:ro
Volume=/srv/nlp/runtime/app:/opt/keiba:ro
Volume=/srv/nlp/runtime/data:/var/lib/keiba
Volume=/srv/nlp/runtime/work:/opt/nlp-research:ro
Volume=/srv/nlp/runtime/database:/run/keiba/database:ro
Volume=/srv/nlp/runtime/app/store.py:/opt/nlp-db/store.py:ro
Volume=/srv/nlp/runtime/app/profile_db.py:/opt/nlp-db/profile_db.py:ro
Environment=HERMES_SKIP_CONFIG_MIGRATION=1
Environment=TZ=Asia/Tokyo
Environment=KEIBA_RESEARCH_DIR=/var/lib/keiba
Environment=KEIBA_BROWSER_EXECUTABLE=/usr/bin/chromium
Environment=KEIBA_RUNTIME_DB=1
Environment=KEIBA_RESEARCH_ACTOR=hermes
Environment=KEIBA_INTERPRET_SKILL=/opt/data/skills/keiba-interpret/SKILL.md
PodmanArgs=--memory=3g --cpus=1.5
Exec=sleep infinity

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
